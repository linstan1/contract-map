{
  "name": "contract-map",
  "version": "1.0.0",
  "description": "An execution-oriented map of one EVM contract: what it is, what each function does, who it calls, and who calls it.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "ethereum",
    "evm",
    "solidity",
    "vyper",
    "bytecode",
    "trace",
    "static-analysis",
    "call-graph",
    "bun"
  ],
  "scripts": {
    "dev": "bun run server.ts",
    "start": "bun run server.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "smoke": "bun run scripts/smoke.ts",
    "probe-chains": "bun run scripts/probe-chains.ts",
    "check-secrets": "bun run scripts/check-secrets.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.5",
    "typescript": "5.9.2"
  }
}
