# Every user supplies their own RPC endpoint. This project ships none.
# The server reads this file, and no value reaches the browser. src/rpc.ts
# scrubs every credential from every error message.
#
# Pick ONE of the two ways below.

# Way 1. Any provider, by full URL. This value serves every chain.
# RPC_URL=https://your-provider.example/your-path

# Way 1b. One chain only. The name is RPC_URL_ plus the chain key in capitals,
# for example RPC_URL_ETHEREUM, RPC_URL_BASE, RPC_URL_ARBITRUM. A per-chain
# value wins over RPC_URL.
# RPC_URL_ETHEREUM=https://your-provider.example/your-path

# Way 2. An Alchemy key. The code then builds the Alchemy URL for each chain.
ALCHEMY_API_KEY=

# The observed-execution half and the proof links need one of these from your
# provider:
#   trace_filter and trace_transaction, or
#   debug_traceTransaction with the callTracer.
# A provider without them still answers the static half: bytecode, source,
# proxy resolution and possible call paths.

# Optional. Set a token to gate every /api/ route. The page then asks for it once
# and keeps it in localStorage.
# AUTH_TOKEN=

# Optional. The server binds 127.0.0.1 by default. Any other host requires
# AUTH_TOKEN, and the server refuses to start without one.
# HOST=127.0.0.1
# PORT=8787
