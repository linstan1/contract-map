# Required. Any Alchemy key works. The server reads this file, and the key never
# reaches the browser. src/rpc.ts scrubs it from every error message.
ALCHEMY_API_KEY=

# Optional. Set a token to gate every /api/ route. The page then asks for it once
# and keeps it in localStorage.
# AUTH_TOKEN=

# Optional. The server binds 127.0.0.1 by default. Any other host requires
# AUTH_TOKEN, and the server refuses to start without one.
# HOST=127.0.0.1
# PORT=8787
